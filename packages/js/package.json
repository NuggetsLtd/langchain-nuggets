{
  "name": "@nuggetslife/langchain-nuggets",
  "version": "1.0.0",
  "description": "Nuggets authority middleware for LangChain.js / LangGraph.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/agent.ts --format esm --dts --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "nuggets",
    "authority",
    "middleware",
    "trust",
    "ai",
    "agents"
  ],
  "license": "MIT",
  "homepage": "https://nuggets.life",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NuggetsLtd/langchain-nuggets.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/NuggetsLtd/langchain-nuggets/issues"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "jose": "^6.1.3"
  },
  "peerDependencies": {
    "langchain": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "langchain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "langchain": "^1.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
