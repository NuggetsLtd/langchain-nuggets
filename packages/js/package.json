{
  "name": "@nuggetslife/langchain-nuggets",
  "version": "0.1.0",
  "description": "Nuggets authority middleware for LangChain.js / LangGraph.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "nuggets",
    "authority",
    "middleware",
    "trust",
    "ai",
    "agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
